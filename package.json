{
  "name": "electron-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Electron app that runs an MCP (Model Context Protocol) server - for Cursor, Claude Desktop, etc.",
  "keywords": [
    "electron",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter electron-mcp-server build",
    "start": "bun run --filter electron-mcp-server start",
    "mcp": "bun run --filter electron-mcp-server mcp",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.3.0"
  }
}
