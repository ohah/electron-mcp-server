{
  "name": "electron-mcp-server",
  "version": "1.0.0",
  "description": "MCP server (Node bin) for Electron app automation via CDP. Use with any Electron app running --remote-debugging-port=9222.",
  "bin": {
    "electron-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "bunup",
    "mcp:run": "node dist/index.js",
    "mcp": "bun run build && node dist/index.js",
    "test": "bun test",
    "test:e2e": "bunup && bun test tests/e2e",
    "test:e2e:node": "bunup && node tests/e2e/mcp-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "playwright": "^1.49.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.0",
    "bunup": "^0.16.22",
    "typescript": "^5.9.3"
  }
}
