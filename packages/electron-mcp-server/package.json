{
  "name": "@ohah/electron-mcp-server",
  "version": "0.1.0-rc.1",
  "description": "MCP server (Node bin) for Electron app automation via CDP. Use with any Electron app running --remote-debugging-port=9222.",
  "keywords": [
    "automation",
    "cdp",
    "electron",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohah/electron-mcp-server.git"
  },
  "bin": {
    "electron-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunup && node scripts/chmod-dist.mjs",
    "prepublishOnly": "bun run build",
    "mcp:run": "node dist/index.js",
    "mcp": "bun run build && node dist/index.js",
    "test": "bun test",
    "test:e2e": "bunup && bun test tests/e2e",
    "test:e2e:mcp": "bun test tests/e2e/mcp-with-electron.e2e.test.ts",
    "test:e2e:electron": "bun test tests/e2e/electron-playwright.e2e.test.ts",
    "test:e2e:node": "bunup && node tests/e2e/mcp-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.0",
    "bunup": "^0.16.22",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
